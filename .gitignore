# virtual environments
.venv/
env/
venv/

# Jupyter
.ipynb_checkpoints/

# data: downloaded by the notebook, not committed
*.csv
**/data/*
!**/data/.gitkeep

# model files: on Hugging Face, not on GitHub
*.onnx
*.pt
*.joblib

# Cloudflare and Node
node_modules/
.wrangler/

